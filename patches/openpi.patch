+@dataclasses.dataclass(frozen=True)
+class LeRobotTrossenDataConfig(DataConfigFactory):
+    """DataConfig for our merged Trossen lift-eggplant LeRobot dataset.
+
+    The dataset lives at $HF_LEROBOT_HOME/local/trossen_lift_eggplant and has:
+      observation.images.cam_main, observation.images.cam_wrist  (uint8 H,W,C 480x640x3)
+      observation.state  (7,)
+      action             (7,)  -- 6 arm joints + 1 gripper, absolute joint positions
+    """
+
+    use_delta_joint_actions: bool = True
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        repack_transform = _transforms.Group(
+            inputs=[
+                _transforms.RepackTransform(
+                    {
+                        "observation/image": "observation.images.cam_main",
+                        "observation/wrist_image": "observation.images.cam_wrist",
+                        "observation/state": "observation.state",
+                        "actions": "action",
+                        "prompt": "prompt",
+                    }
+                )
+            ]
+        )
+
+        data_transforms = _transforms.Group(
+            inputs=[trossen_policy.TrossenInputs(model_type=model_config.model_type)],
+            outputs=[trossen_policy.TrossenOutputs()],
+        )
+
+        if self.use_delta_joint_actions:
+            # First 6 joints -> delta wrt current state; gripper (last dim) stays absolute.
+            delta_action_mask = _transforms.make_bool_mask(6, -1)
+            data_transforms = data_transforms.push(
+                inputs=[_transforms.DeltaActions(delta_action_mask)],
+                outputs=[_transforms.AbsoluteActions(delta_action_mask)],
+            )
+
+        model_transforms = ModelTransformFactory()(model_config)
+
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+            action_sequence_keys=("action",),
+        )
+
+
